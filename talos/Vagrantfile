# -*- mode: ruby -*-
# vi: set ft=ruby :
# Node topology is driven by .nodes.json (generated by Terraform).
# Change control_plane_count / worker_count in variables.tf, then re-run just up.

require 'json'

ENV['VAGRANT_EXPERIMENTAL'] ||= 'none_communicator'

nodes_file = File.join(__dir__, '.nodes.json')
abort "Run 'just up' (terraform apply) first — .nodes.json not found" unless File.exist?(nodes_file)
cfg        = JSON.parse(File.read(nodes_file))
BOX_NAME   = cfg['box_name']
BOX_VER    = cfg['box_version']
NODES      = cfg['nodes'].map { |n| n.transform_keys(&:to_sym) }.freeze

Vagrant.configure("2") do |config|
  config.vm.box         = BOX_NAME
  config.vm.box_version = BOX_VER
  config.vm.communicator  = "none"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  NODES.each do |node|
    config.vm.define node[:name] do |n|
      n.vm.hostname = node[:name]

      # Host-only NIC — static IP applied by Talos machine config after first boot.
      n.vm.network "private_network", ip: node[:ip]

      # NAT port-forward so talosctl can reach the maintenance API on port 50000
      # before static IPs are configured.
      n.vm.network "forwarded_port",
        guest:        50000,
        host:         node[:talos_port],
        host_ip:      "127.0.0.1",
        id:           "talos-api",
        auto_correct: false

      n.vm.provider "virtualbox" do |vb|
        vb.name   = "talos-#{node[:name]}"
        vb.cpus   = node[:cpus]
        vb.memory = node[:memory]
        vb.gui    = false

        vb.customize ["modifyvm", :id, "--uart1", "0x3F8", "4"]
        vb.customize ["modifyvm", :id, "--uartmode1", "file", File::NULL]
      end
    end
  end
end
