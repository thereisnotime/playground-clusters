# -*- mode: ruby -*-
# vi: set ft=ruby :

# The "none" communicator is experimental in Vagrant 2.4.x and must be
# opted into explicitly — without this it silently fails to register.
ENV['VAGRANT_EXPERIMENTAL'] ||= 'none_communicator'

BOX_NAME      = "theorigamicorporation/talos-virtualbox"
BOX_VERSION   = "2.0.0"  # Talos v1.12.7 — maintenance mode, no pre-applied config

NODES = [
  { name: "cp-1",     ip: "192.168.56.10", talos_port: 50001, cpus: 2, memory: 2048 },
  { name: "worker-1", ip: "192.168.56.11", talos_port: 50002, cpus: 2, memory: 2048 },
  { name: "worker-2", ip: "192.168.56.12", talos_port: 50003, cpus: 2, memory: 2048 },
].freeze

Vagrant.configure("2") do |config|
  config.vm.box         = BOX_NAME
  config.vm.box_version = BOX_VERSION
  config.vm.communicator = "none"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  NODES.each do |node|
    config.vm.define node[:name] do |n|
      n.vm.hostname = node[:name]

      # Host-only adapter for inter-node traffic; static IP is applied by Talos
      # machine config after first boot (Vagrant cannot configure it without SSH)
      n.vm.network "private_network", ip: node[:ip]

      # NAT port forward so talosctl can reach the maintenance API before static
      # IPs are applied
      n.vm.network "forwarded_port",
        guest:        50000,
        host:         node[:talos_port],
        host_ip:      "127.0.0.1",
        id:           "talos-api",
        auto_correct: false

      n.vm.provider "virtualbox" do |vb|
        vb.name   = "talos-#{node[:name]}"
        vb.cpus   = node[:cpus]
        vb.memory = node[:memory]
        vb.gui    = false

        # Talos doesn't use a serial console but this quiets VirtualBox noise
        vb.customize ["modifyvm", :id, "--uart1", "0x3F8", "4"]
        vb.customize ["modifyvm", :id, "--uartmode1", "file", File::NULL]
      end
    end
  end
end
